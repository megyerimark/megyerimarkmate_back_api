APP_NAME="Megyeri Márk | Webfejlesztés"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=megyeri_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Megyeri Márk Máté | Webfejlesztés"
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_MAIL_ENABLED=false
PORTFOLIO_CUSTOMER_RECEIPT_ENABLED=true
PORTFOLIO_CLIENT_ACCESS_DAYS=90
# Élesben (APP_ENV=production) alapból kötelező; fejlesztéshez false.
PORTFOLIO_REQUIRE_ADMIN_2FA=false
PORTFOLIO_RETENTION_MONTHS=24
PORTFOLIO_BACKUP_KEEP=14
# PORTFOLIO_BACKUP_PATH=/home/felhasznalo/mentesek

VITE_APP_NAME="${APP_NAME}"
