# ÉLES KÖRNYEZET – másold .env néven, és töltsd ki. Ezt a fájlt SOHA ne töltsd fel kitöltve a gitbe.
APP_NAME="Megyeri Márk | Webfejlesztés"
APP_ENV=production
# php artisan key:generate
APP_KEY=
# élesben SOHA ne legyen true: kiírná a hibák részleteit és a beállításokat
APP_DEBUG=false
APP_URL=https://megyerimarkmate.hu
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
# külön, csak ehhez az adatbázishoz jogosult felhasználó (ne root)
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# süti csak HTTPS-en
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=megyerimarkmate.hu,www.megyerimarkmate.hu
CORS_ALLOWED_ORIGINS=https://megyerimarkmate.hu,https://www.megyerimarkmate.hu
# Csak ha a tárhely terheléselosztó / Cloudflare mögött van.
# Cloudflare mögött: TRUSTED_PROXIES=cloudflare (csak a Cloudflare címeiről fogadjuk el a látogató IP-jét).
# SOHA ne legyen „*”, ha a szerver Cloudflare nélkül is elérhető: akkor bárki hamisíthatná az IP-címét,
# és kikerülhetné a kéréskorlátokat. Más proxy esetén a proxy IP-címe(i) vesszővel elválasztva.
# TRUSTED_PROXIES=cloudflare

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# file: gyors, nem a (távoli) MySQL-t terheli – a kéréskorlátok és a nyilvános tartalom gyorsítótára is ezt használja
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@megyerimarkmate.hu
MAIL_FROM_NAME="Megyeri Márk Máté | Webfejlesztés"

PORTFOLIO_FRONTEND_URL=https://megyerimarkmate.hu
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_MAIL_ENABLED=true
PORTFOLIO_CUSTOMER_RECEIPT_ENABLED=true
PORTFOLIO_CLIENT_ACCESS_DAYS=90
PORTFOLIO_REQUIRE_ADMIN_2FA=true
# Kötelező minimális előleg az ajánlatokban (%), 0 = nincs minimum
PORTFOLIO_MIN_DEPOSIT_PERCENT=30
# Átadandó kód / csomag (ZIP) legnagyobb mérete MB-ban; a PHP upload_max_filesize / post_max_size is legyen ekkora
PORTFOLIO_DELIVERABLE_MAX_MB=100
PORTFOLIO_RETENTION_MONTHS=24
PORTFOLIO_BACKUP_KEEP=14
# KÖTELEZŐ élesben: mentések titkosítása. Kulcs: php artisan portfolio:backup-key
# A kulcsot a jelszókezelődbe is mentsd el – nélküle a mentés nem állítható vissza!
PORTFOLIO_BACKUP_KEY=
# Külső mentés S3-kompatibilis tárhelyre (pl. Backblaze B2, Cloudflare R2). Előtte egyszer, helyben:
#   composer require league/flysystem-aws-s3-v3 "^3.0"   (majd deploy)
PORTFOLIO_BACKUP_DISK=
PORTFOLIO_BACKUP_DISK_KEEP=30
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
# pl. Backblaze B2: https://s3.eu-central-003.backblazeb2.com  · Cloudflare R2: https://<account>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto

# Online fizetés (Stripe) – üresen a kártyás fizetés ki van kapcsolva, az átutalásos előleg-jóváírás működik.
# dashboard.stripe.com → Fejlesztők → API-kulcsok (élesben sk_live_..., teszteléshez sk_test_...)
STRIPE_SECRET=
# Fejlesztők → Webhookok → végpont: https://<domain>/api/stripe/webhook → „Signing secret”
STRIPE_WEBHOOK_SECRET=

# Bot-védelem (Cloudflare Turnstile) az ajánlatkérésen, időpontfoglaláson, hírlevélen és az admin belépésen.
# dash.cloudflare.com → Turnstile → Add widget → domain: megyerimarkmate.hu, mód: Managed.
# Élesben ERŐSEN ajánlott; üresen a robotszűrés ki van kapcsolva.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=megyerimarkmate.hu,www.megyerimarkmate.hu
# ÁSZF-verzió – ÁSZF-módosításkor növeld (a frontend terms.ts verziójával együtt)!
PORTFOLIO_TERMS_VERSION=2026-11
# Globális API-korlát / IP / perc
PORTFOLIO_API_RATE_PER_MINUTE=300
